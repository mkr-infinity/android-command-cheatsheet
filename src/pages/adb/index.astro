---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { InteractiveExplorer } from '../../components/InteractiveExplorer';
import { adbCommands } from '../../data/adb';
import { Terminal, BookOpen, ArrowRight, ShieldCheck } from 'lucide-react';

const rawBase = import.meta.env.BASE_URL || '/';
const basePath = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<BaseLayout
  title="ADB Commands Cheatsheet — Android Debug Bridge Reference"
  description="Comprehensive ADB command reference with explanations, syntax, options, and examples for app management, debugging, shell, file transfers, and system control."
>
  <div class="space-y-8">
    {/* Page Header */}
    <div class="clay-card p-6 md:p-8 space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-neutral-200 dark:border-neutral-800">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="p-1.5 rounded-lg bg-cyber-limeDim text-cyber-lime border border-cyber-limeBorder">
              <Terminal className="w-5 h-5 text-neutral-900 dark:text-cyber-lime" />
            </span>
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              Tool Documentation
            </span>
          </div>

          <h1 class="text-2xl md:text-3xl font-mono font-bold text-neutral-900 dark:text-cyber-text">
            ADB Commands Reference
          </h1>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 max-w-2xl leading-relaxed font-sans">
            Android Debug Bridge (adb) is a versatile command-line tool that lets you communicate with a device. The adb command facilitates a variety of device actions, such as installing and debugging apps.
          </p>
        </div>

        {/* Quick Link to Learn ADB */}
        <a
          href={`${basePath}/learn/adb/`.replace(/\/+/g, '/')}
          class="clay-button shrink-0 inline-flex items-center gap-2 px-4 py-2.5 text-xs text-neutral-900 dark:text-cyber-text hover:dark:text-cyber-lime font-semibold"
        >
          <BookOpen className="w-4 h-4 text-cyber-lime" />
          <span>Getting Started with ADB</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      {/* Metrics Banner */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2 text-xs font-mono">
        <div class="p-3 rounded-xl bg-neutral-100/50 dark:bg-neutral-900/50 border border-neutral-200/60 dark:border-neutral-800/60">
          <span class="text-neutral-500 dark:text-neutral-400 block text-[11px]">TOTAL COMMANDS</span>
          <strong class="text-base text-neutral-900 dark:text-cyber-lime">{adbCommands.length} indexed</strong>
        </div>
        <div class="p-3 rounded-xl bg-neutral-100/50 dark:bg-neutral-900/50 border border-neutral-200/60 dark:border-neutral-800/60">
          <span class="text-neutral-500 dark:text-neutral-400 block text-[11px]">CATEGORIES</span>
          <strong class="text-base text-neutral-900 dark:text-cyber-text">12 sections</strong>
        </div>
        <div class="p-3 rounded-xl bg-neutral-100/50 dark:bg-neutral-900/50 border border-neutral-200/60 dark:border-neutral-800/60">
          <span class="text-neutral-500 dark:text-neutral-400 block text-[11px]">PORT (DEFAULT)</span>
          <strong class="text-base text-neutral-900 dark:text-cyber-text">TCP 5037</strong>
        </div>
        <div class="p-3 rounded-xl bg-neutral-100/50 dark:bg-neutral-900/50 border border-neutral-200/60 dark:border-neutral-800/60">
          <span class="text-neutral-500 dark:text-neutral-400 block text-[11px]">RUNTIME PROTOCOL</span>
          <strong class="text-base text-cyber-lime">USB &amp; TCP/IP</strong>
        </div>
      </div>
    </div>

    {/* Command Explorer dedicated to ADB */}
    <InteractiveExplorer client:load initialTool="adb" basePath={basePath} />
  </div>
</BaseLayout>
