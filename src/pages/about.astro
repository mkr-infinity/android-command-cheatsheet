---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Sparkles, Bug, Terminal, Zap, ShieldCheck } from 'lucide-react';
import { AboutProfile } from '../components/AboutProfile';
import { createFeatureRequestUrl, createReportIssueUrl } from '../utils/github';

const rawBase = import.meta.env.BASE_URL || '/';
const basePath = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const featureUrl = createFeatureRequestUrl();
const issueUrl = createReportIssueUrl();
const logoFullSrc = `${basePath}/assets/branding/logo.svg`.replace(/\/+/g, '/');
---

<BaseLayout
  title="About — Android Command Cheatsheet"
  description="About Android Command Cheatsheet, project maintainer Mohammad Kaif Raja (@mkr-infinity), project mission, and sponsor channels."
>
  <article class="max-w-4xl mx-auto space-y-12">
    <!-- Header Hero Card -->
    <div class="clay-card p-8 md:p-10 space-y-6">
      <div class="flex items-center gap-4">
        <img
          src={logoFullSrc}
          alt="Android Command Cheatsheet Logo"
          class="h-9 sm:h-11 w-auto object-contain"
        />
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-mono font-bold text-neutral-950 dark:text-cyber-text">
          About the Project
        </h1>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans">
          <strong>Android Command Cheatsheet</strong> is a fast, data-driven, searchable technical reference console for Android ADB and Fastboot commands, built with a refined Cybercore aesthetic.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-neutral-200 dark:border-neutral-800">
        <div class="p-4 rounded-xl bg-neutral-100/60 dark:bg-neutral-900/60 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <span class="text-xs font-mono text-cyber-lime font-bold">DISCOVER</span>
          <p className="text-xs text-neutral-600 dark:text-neutral-400">Instant fuzzy search across syntax, commands, categories, and aliases.</p>
        </div>
        <div class="p-4 rounded-xl bg-neutral-100/60 dark:bg-neutral-900/60 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <span class="text-xs font-mono text-cyber-lime font-bold">UNDERSTAND</span>
          <p className="text-xs text-neutral-600 dark:text-neutral-400">Concise purpose explanations, options, flags, and transparent risk ratings.</p>
        </div>
        <div class="p-4 rounded-xl bg-neutral-100/60 dark:bg-neutral-900/60 border border-neutral-200 dark:border-neutral-800 space-y-1">
          <span class="text-xs font-mono text-amber-700 dark:text-amber-400 font-bold">STANDARDIZE</span>
          <p className="text-xs text-neutral-600 dark:text-neutral-400">Consolidates fragmented official Android documentation into a unified reference.</p>
        </div>
      </div>
    </div>

    <!-- Live Developer Profile, Companion Guides & Sponsor Section -->
    <AboutProfile client:load />

    <!-- Contribute & Feedback -->
    <section class="clay-card p-6 md:p-8 space-y-4">
      <div>
        <h2 class="text-lg font-mono font-bold text-neutral-950 dark:text-cyber-text">
          Contribute &amp; Feedback
        </h2>
        <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed font-sans">
          Encountered an outdated command, missing option, or have an idea for an enhancement? Open an issue or suggestion directly on GitHub.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href={featureUrl}
          target="_blank"
          rel="noreferrer"
          class="clay-button inline-flex items-center gap-2 px-4 py-2.5 text-xs md:text-sm text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-cyber-lime"
        >
          <Sparkles className="w-4 h-4 text-cyber-lime" />
          <span>Request a Feature</span>
        </a>

        <a
          href={issueUrl}
          target="_blank"
          rel="noreferrer"
          class="clay-button inline-flex items-center gap-2 px-4 py-2.5 text-xs md:text-sm text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-amber-400"
        >
          <Bug className="w-4 h-4 text-amber-700 dark:text-amber-400" />
          <span>Report an Issue</span>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
