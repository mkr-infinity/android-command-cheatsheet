---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BookOpen, Terminal, Zap, ArrowRight, ShieldCheck, Cpu, HardDrive, Unlock, Layers, ExternalLink } from 'lucide-react';

const rawBase = import.meta.env.BASE_URL || '/';
const basePath = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<BaseLayout
  title="Learn ADB & Fastboot — Setup Guides and Tutorials"
  description="Master Android command line tools with step-by-step setup guides, developer options configuration, USB debugging, partition concepts, and bootloader management."
>
  <div class="space-y-10 max-w-5xl mx-auto">
    {/* Header */}
    <div class="space-y-3">
      <div class="clay-pill text-xs font-mono text-neutral-900 dark:text-cyber-lime">
        <BookOpen className="w-3.5 h-3.5 text-cyber-lime" />
        <span>KNOWLEDGE BASE &amp; TUTORIALS</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-mono font-bold text-neutral-900 dark:text-cyber-text">
        Learn Android Tooling
      </h1>
      <p class="text-neutral-600 dark:text-neutral-300 text-sm md:text-base max-w-2xl leading-relaxed font-sans">
        Step-by-step technical guides designed for developers, technicians, and Android enthusiasts to configure, debug, and flash devices with confidence.
      </p>
    </div>

    {/* Two Primary Pillars with Claymorphic Cards */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* ADB Guide Card */}
      <a
        href={`${basePath}/learn/adb/`.replace(/\/+/g, '/')}
        class="clay-card group p-6 md:p-8 flex flex-col justify-between hover:translate-y-[-2px] transition-all"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="p-2.5 rounded-xl bg-cyber-limeDim text-cyber-lime border border-cyber-limeBorder shadow-sm">
              <Terminal className="w-6 h-6 text-neutral-900 dark:text-cyber-lime" />
            </span>
            <span class="clay-pill text-xs text-neutral-600 dark:text-neutral-400">
              8 Step Guide
            </span>
          </div>

          <div>
            <h2 class="text-xl font-mono font-bold text-neutral-900 dark:text-cyber-text group-hover:text-cyber-lime transition-colors">
              Getting Started with ADB
            </h2>
            <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed font-sans">
              Understand the client-server architecture of Android Debug Bridge, install SDK platform tools, enable Developer Options, authorize USB debugging keys, and connect over Wi-Fi.
            </p>
          </div>

          <ul class="space-y-2 text-xs font-mono text-neutral-500 dark:text-neutral-400 pt-2 border-t border-neutral-200 dark:border-neutral-800">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyber-lime" />
              <span>Platform-tools installation (Win / Mac / Linux)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyber-lime" />
              <span>Unlocking Developer Options &amp; USB Debugging</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyber-lime" />
              <span>Device detection verification &amp; RSA keys</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyber-lime" />
              <span>Wireless ADB pairing &amp; troubleshooting</span>
            </li>
          </ul>
        </div>

        <div class="pt-6 mt-6 flex items-center justify-between border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono text-neutral-900 dark:text-cyber-lime font-bold">
          <span>Read ADB Guide</span>
          <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </div>
      </a>

      {/* Fastboot Guide Card */}
      <a
        href={`${basePath}/learn/fastboot/`.replace(/\/+/g, '/')}
        class="clay-card group p-6 md:p-8 flex flex-col justify-between hover:translate-y-[-2px] transition-all"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="p-2.5 rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 shadow-sm">
              <Zap className="w-6 h-6" />
            </span>
            <span class="clay-pill text-xs text-neutral-600 dark:text-neutral-400">
              8 Step Guide
            </span>
          </div>

          <div>
            <h2 class="text-xl font-mono font-bold text-neutral-900 dark:text-cyber-text group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">
              Getting Started with Fastboot
            </h2>
            <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed font-sans">
              Master the low-level Android bootloader protocol. Learn hardware key combinations, check partition tables, understand A/B slot architecture, unlock security, and flash safely.
            </p>
          </div>

          <ul class="space-y-2 text-xs font-mono text-neutral-600 dark:text-neutral-400 pt-2 border-t border-neutral-200 dark:border-neutral-800">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400" />
              <span>Entering Bootloader &amp; FastbootD mode</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400" />
              <span>Understanding Partitions &amp; A/B Slot System</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400" />
              <span>Bootloader Unlocking &amp; Critical Data Precautions</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400" />
              <span>Flashing Kernels, Recoveries, and Full Factory Images</span>
            </li>
          </ul>
        </div>

        <div class="pt-6 mt-6 flex items-center justify-between border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono text-amber-700 dark:text-amber-400 font-bold">
          <span>Read Fastboot Guide</span>
          <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </div>
      </a>
    </div>

    {/* Official Companion Master Guides */}
    <div class="space-y-4 pt-6 border-t border-neutral-200 dark:border-neutral-800">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-bold">
          <BookOpen className="w-4 h-4 text-cyber-lime" />
          <span>Official Companion Guide Repositories</span>
        </div>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-sans">
          Deep-dive repositories created and maintained by @mkr-infinity for device-specific unlock steps and Project Treble flashing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {/* Companion 1 */}
        <div class="clay-card p-5 sm:p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <span class="clay-pill text-[11px] font-mono text-amber-700 dark:text-amber-400 bg-amber-500/10 border-amber-500/30">
              <Unlock className="w-3 h-3 inline mr-1" />
              BOOTLOADER UNLOCK
            </span>
            <h3 class="text-base font-mono font-bold text-neutral-900 dark:text-cyber-text">
              Guide to Unlock Bootloader
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-300 font-sans leading-relaxed">
              Step-by-step universal guide for unlocking bootloaders on Xiaomi (Mi Unlock Tool), OnePlus, Google Pixel, Motorola, and generic Qualcomm/MediaTek devices.
            </p>
          </div>
          <a
            href="https://github.com/mkr-infinity/Guide-to-unlock-Bootloader"
            target="_blank"
            rel="noreferrer"
            class="clay-button-primary w-full py-2 px-3 text-xs flex items-center justify-center gap-2"
          >
            <span>Read on GitHub</span>
            <ExternalLink className="w-3.5 h-3.5" />
          </a>
        </div>

        {/* Companion 2 */}
        <div class="clay-card p-5 sm:p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <span class="clay-pill text-[11px] font-mono text-cyber-lime bg-cyber-lime/10 border-cyber-lime/30">
              <Layers className="w-3 h-3 inline mr-1" />
              PROJECT TREBLE &amp; GSI
            </span>
            <h3 class="text-base font-mono font-bold text-neutral-900 dark:text-cyber-text">
              Guide for Flashing GSI to Any Device
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-300 font-sans leading-relaxed">
              Complete engineering tutorial for flashing Generic System Images (GSIs) via fastbootd on Android 10+ devices with dynamic partitions and vbmeta verification.
            </p>
          </div>
          <a
            href="https://github.com/mkr-infinity/Guide-for-flashing-GSI-to-any-device"
            target="_blank"
            rel="noreferrer"
            class="clay-button-primary w-full py-2 px-3 text-xs flex items-center justify-center gap-2"
          >
            <span>Read on GitHub</span>
            <ExternalLink className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
